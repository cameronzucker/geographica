# Geographica Configuration
# Copy to .env and modify as needed
# Auto-generated by setup wizard — regenerating overwrites this file.

# TLS_MODE: http | https | tailscale
TLS_MODE=http
TLS_CERT_DIR=./tls
TLS_PORT=443

# Data region bounding box (lon_min, lat_min, lon_max, lat_max)
# Western US: AZ, CA, CO, ID, MT, NV, NM, OR, UT, WA, WY
BBOX=-124.8,31.3,-102.0,49.0

# Host paths (bind-mounted into containers)
DATA_HOST_PATH=/srv/geographica/data
SCRIPTS_HOST_PATH=/home/administrator/Code/geographica/scripts

# Speech-to-text backend: cpu | npu
STT_BACKEND=cpu

# PostgreSQL / Nominatim tuning (16GB profile)
NOMINATIM_MEMORY=8G
POSTGRES_SHARED_BUFFERS=2GB
POSTGRES_MAINTENANCE_WORK_MEM=1GB
POSTGRES_EFFECTIVE_CACHE_SIZE=6GB
POSTGRES_WORK_MEM=32MB
POSTGRES_AUTOVACUUM_WORK_MEM=256MB

# Valhalla routing
VALHALLA_MEMORY=4G
VALHALLA_THREADS=4

# Services
TILESERVER_MEMORY=1G
STT_MEMORY=1536M
PIPELINE_MEMORY=4G
PIPELINE_GDAL_CACHE=1024
PLANETILER_HEAP=4g

# GPS device (typically /dev/ttyAMA0 for Pi GPS hat)
GPS_DEVICE=/dev/ttyAMA0
