# Geographica Configuration
# Copy to .env and modify as needed
# Auto-generated by setup wizard — regenerating overwrites this file.

# TLS_MODE: http | https | tailscale
TLS_MODE=http
TLS_CERT_DIR=./tls
TLS_PORT=443

# Data region bounding box (lon_min, lat_min, lon_max, lat_max)
# Western US: AZ, CA, CO, ID, MT, NV, NM, OR, UT, WA, WY
BBOX=-124.8,31.3,-102.0,49.0

# Host paths (bind-mounted into containers)
DATA_HOST_PATH=/srv/geographica/data
SCRIPTS_HOST_PATH=/home/administrator/Code/geographica/scripts

# Speech-to-text backend: cpu | npu
STT_BACKEND=cpu

# ----------------------------------------------------------------------
# Memory tuning — conservative "good neighbor" defaults
# ----------------------------------------------------------------------
# These defaults leave ~6 GB free on a 16 GB Pi (and ~4 GB free on an
# 8 GB Pi) for the host kernel, page cache, and any OTHER services you
# run on the same box. They're tuned for safe coexistence, not peak
# Geographica performance.
#
# On a Pi dedicated to Geographica, you can raise these to trade host
# headroom for better Nominatim/Valhalla performance. Keep the always-on
# sum (NOMINATIM_MEMORY + VALHALLA_MEMORY + TILESERVER_MEMORY + STT_MEMORY)
# below (host_ram - 2 GB) to avoid OOM.

# PostgreSQL / Nominatim tuning (16GB profile)
NOMINATIM_MEMORY=5G
POSTGRES_SHARED_BUFFERS=1GB
POSTGRES_MAINTENANCE_WORK_MEM=512MB
POSTGRES_EFFECTIVE_CACHE_SIZE=3GB
POSTGRES_WORK_MEM=32MB
POSTGRES_AUTOVACUUM_WORK_MEM=256MB

# Valhalla routing
VALHALLA_MEMORY=3G
VALHALLA_THREADS=4

# Services
TILESERVER_MEMORY=1G
STT_MEMORY=1G
PIPELINE_MEMORY=3G
PIPELINE_GDAL_CACHE=1024
PLANETILER_HEAP=3g

# GPS device (typically /dev/ttyAMA0 for Pi GPS hat)
GPS_DEVICE=/dev/ttyAMA0
