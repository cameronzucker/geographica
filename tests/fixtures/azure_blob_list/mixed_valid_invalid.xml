    <BlobPrefix><Name>BADFORMAT/</Name></BlobPrefix>
    <!-- Invalid: AK maps to None in SLUG_BY_USPS (excluded state) -->
    <BlobPrefix><Name>AK_NAIP_2021_9999/</Name></BlobPrefix>
    <!-- Invalid: non-directory blob (no trailing slash) -->
    <BlobPrefix><Name>some_random_file.txt</Name></BlobPrefix>
  </Blobs>
