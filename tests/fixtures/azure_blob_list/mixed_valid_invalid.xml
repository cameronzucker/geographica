<EnumerationResults ServiceEndpoint="https://coastalimagery.blob.core.windows.net/" ContainerName="digitalcoast">
  <Prefix></Prefix>
  <Delimiter>/</Delimiter>
  <Blobs>
    <!-- Valid: parseable USPS directory -->
    <BlobPrefix><Name>AZ_NAIP_2021_9596/</Name></BlobPrefix>
